diff --git a/src/modules/proxy-gateway/server/common/utils/request-header-profile.ts b/src/modules/proxy-gateway/server/common/utils/request-header-profile.ts
new file mode 100644
index 0000000..c323705
--- /dev/null
+++ b/src/modules/proxy-gateway/server/common/utils/request-header-profile.ts
@@ -0,0 +1,34 @@
+export type RequestHeaderProfile = 'official' | 'manager';
+
+export const OFFICIAL_HTTP_USER_AGENT =
+  'antigravity/hub/2.15.0 (aidev_client; os_type=windows; arch=amd64; cl=983516863)';
+
+export function resolveRequestHeaderProfile(
+  env: NodeJS.ProcessEnv = process.env,
+): RequestHeaderProfile {
+  return env.AGM_CORE_HEADER_PROFILE?.trim().toLowerCase() === 'manager'
+    ? 'manager'
+    : 'official';
+}
+
+export function createInternalRequestHeaders(params: {
+  accessToken: string;
+  includeProject: boolean;
+  managerUserAgent: string;
+  project?: string;
+  profile?: RequestHeaderProfile;
+}): Record<string, string> {
+  const profile = params.profile ?? resolveRequestHeaderProfile();
+  const headers: Record<string, string> = {
+    Authorization: `Bearer ${params.accessToken}`,
+    'Accept-Encoding': 'gzip',
+    'Content-Type': 'application/json',
+    'User-Agent':
+      profile === 'manager' ? params.managerUserAgent : OFFICIAL_HTTP_USER_AGENT,
+  };
+  const project = params.project?.trim();
+  if (profile === 'manager' && params.includeProject && project) {
+    headers['x-goog-user-project'] = project;
+  }
+  return headers;
+}
