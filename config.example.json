{
  "listen_host": "127.0.0.1",
  "listen_port": 8400,
  "fake_api_key": "sk-relay-local-0000",
  "real_deepseek_key": "sk-your-deepseek-key-here",
  "record_dir": "",
  "max_body_capture": 2000000,
  "proxy_url": "",
  "codex_proxy_key": "your-codex-proxy-key-here",
  "codex_exe": "",
  "codex_config": "",
  "upstreams": {
    "deepseek": {
      "base": "https://api.deepseek.com/anthropic",
      "key_env": "real_deepseek_key",
      "proxy_url": "direct"
    },
    "codex": {
      "base": "http://127.0.0.1:8317",
      "key_env": "codex_proxy_key",
      "proxy_url": "direct"
    }
  },
  "router": {
    "route": "hybrid",
    "tiers": {
      "main": "deepseek-v4-flash",
      "opus": "gpt-5.6-sol",
      "sonnet": "deepseek-v4-flash",
      "fast": "deepseek-v4-flash"
    },
    "effort": "medium"
  },
  "ui_port": 8610
}
